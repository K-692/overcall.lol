# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (all env files ignored except example template)
.env*
!.env.example

# database & local storage
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# vercel & ide
.vercel
.idea
.vscode
*.swp
*.swo

# typescript
*.tsbuildinfo
next-env.d.ts
