# ==============================================================================
# overcall.lol - Environment Configuration Template
# Copy this file to .env.local and configure your environment values.
# NEVER commit your actual .env.local file to source control.
# ==============================================================================

# Application Settings
NEXT_PUBLIC_APP_DOMAIN=overcall.lol
NEXT_PUBLIC_APP_URL=https://overcall.lol
APP_NAME=overcall.lol
APP_CURRENCY=USD

# Database Configuration (Defaults to ./overcall.db in project root if not set)
# DATABASE_PATH=./overcall.db

# Bidding Limits (in cents / minor units: 100 = $1.00 USD)
MIN_INITIAL_BID_MINOR=100
MIN_RAISE_MINOR=100
MAX_BID_MINOR=99999900

# Payment Provider Configuration
# Choose 'mock' for local sandbox testing without third-party credentials,
# or 'paypal' for PayPal Standard / Express Checkout integration.
PAYMENT_PROVIDER=mock

# PayPal Integration (Required if PAYMENT_PROVIDER=paypal)
# PayPal Environment: 'sandbox' (for testing) or 'live' (for production)
PAYPAL_MODE=sandbox

# PayPal API Credentials (from developer.paypal.com)
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here

# PayPal Webhook ID (Optional: for server-side asynchronous webhook verification)
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here
